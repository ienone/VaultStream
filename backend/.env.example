# ====================================================================
# VaultStream 配置文件
# ====================================================================
# 参考部署场景：服务器 + Nginx 反向代理 + 公网访问
#
# 使用方法：
#   cp .env.example .env
#   编辑以下生产必填项，然后 docker compose up -d
# ====================================================================

# ====================================================================
# 必填（生产环境共四项）
# ====================================================================

# 1. 外部访问域名
#    - 用于生成图片、封面等媒体文件的绝对链接
#    - 未设置时媒体 URL 指向 localhost:8000，公网访问时图片全部失效
BASE_URL=https://your-domain.com

# 2. 允许跨域的前端来源（生产模式下不可为 *，否则启动报错）
#    - 填写前端的访问地址，与 BASE_URL 一致即可
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ====================================================================
# 可选
# ====================================================================

# API 访问密钥（生产环境必须显式设置；留空仅适合本地开发自举）
# API_TOKEN=

# 媒体资源级签名密钥（生产环境必须显式设置，且不得与 API_TOKEN 相同）
# MEDIA_SIGNING_SECRET=

# 签名媒体 URL 有效期，单位秒
# MEDIA_URL_TTL_SECONDS=900

# 单个应用内上传文件上限，单位字节（默认 512 MiB）
# CAPTURE_UPLOAD_MAX_BYTES=536870912
